# ===== Academic Paper Assistant v2 - configuration template =====
# Copy to .env and fill in your own values. Never commit .env.

# --- LLM -------------------------------------------------------------------
# "openai" works with any OpenAI-compatible endpoint; "anthropic" uses the
# Messages API.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_FAST=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=300

# --- first administrator (created only when the database is empty) ---------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Administrator

# --- application -----------------------------------------------------------
APP_ENV=production
ALLOW_REGISTRATION=true
TOKEN_TTL_HOURS=336
MAX_CONCURRENT_JOBS=2
MAX_PAPERS_PER_USER=200
JWT_SECRET=

# --- storage (relative paths resolve against the repository root) ----------
DATA_DIR=./data
# DB_PATH=./data/apa.db
# FRONTEND_DIST=./frontend/dist

# --- optional literature sources ------------------------------------------
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_EMAIL=you@example.com

# --- http ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
